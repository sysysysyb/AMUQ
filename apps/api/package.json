{
  "name": "@amuq/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "node --experimental-strip-types src/db/check.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "dev": "node --watch --experimental-strip-types src/http/index.ts --development",
    "dev:worker": "node --watch --experimental-strip-types src/worker.ts",
    "start": "node dist/http/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "5.2.6",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pg-boss": "12.33.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
