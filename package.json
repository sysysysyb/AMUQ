{
  "name": "amuq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:check": "pnpm --filter @amuq/api db:check",
    "db:generate": "pnpm --filter @amuq/api db:generate",
    "db:migrate": "pnpm --filter @amuq/api db:migrate",
    "dev": "pnpm --parallel --filter @amuq/api --filter @amuq/web dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file-if-exists=.env -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('TEST_DATABASE_URL is required for integration tests')\" && node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run apps/api/test/integration",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
