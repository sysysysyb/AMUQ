{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:study-platform:question-package:1.0.0",
  "title": "Generic Question Package Schema",
  "description": "Text-based single-choice question package for manual JSON import, system seed migration, and validated AI output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "bank",
    "sources",
    "sections",
    "questions"
  ],
  "properties": {
    "schemaName": {
      "const": "generic-question-package"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "bank": {
      "$ref": "#/$defs/bank"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "title",
        "languageTag"
      ],
      "properties": {
        "externalId": {
          "$ref": "#/$defs/externalId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "languageTag": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "kind",
        "title"
      ],
      "properties": {
        "externalId": {
          "$ref": "#/$defs/externalId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "uploaded_document",
            "manual_reference",
            "system_seed"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "edition": {
          "type": "string",
          "maxLength": 120
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "title",
        "position"
      ],
      "properties": {
        "externalId": {
          "$ref": "#/$defs/externalId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "position": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "text"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[1-8]$"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "keyConcept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceExternalId"
      ],
      "properties": {
        "sourceExternalId": {
          "$ref": "#/$defs/externalId"
        },
        "printedPages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "pdfPages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "basisSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "sectionExternalId",
        "type",
        "difficulty",
        "prompt",
        "options",
        "correctOptionKey",
        "explanation",
        "tags",
        "references"
      ],
      "properties": {
        "externalId": {
          "$ref": "#/$defs/externalId"
        },
        "sectionExternalId": {
          "$ref": "#/$defs/externalId"
        },
        "type": {
          "const": "single_choice"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "unspecified",
            "easy",
            "medium",
            "hard"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionKey": {
          "type": "string",
          "pattern": "^[1-8]$"
        },
        "explanation": {
          "$ref": "#/$defs/explanation"
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  }
}
